# Frontend environment variables
# Copy this file to .env.local and fill in the values

# Backend API base URL (defaults to same-origin proxy in dev)
VITE_API_BASE_URL=http://localhost:3001

# Shared key used to encrypt password payloads before calling backend auth APIs.
# Keep frontend and backend values identical for local/prod environments.
VITE_AUTH_PAYLOAD_KEY=change-this-auth-payload-key

# Stripe publishable key for card checkout.
# Use your Stripe test or live publishable key from the Stripe Dashboard.
VITE_STRIPE_PUBLISHABLE_KEY=test_publishable_key

# Set to true to show the Mock Pay fallback button in Checkout when Stripe is unavailable.
# This flag does not control visibility of the Payment Integration Test page.
VITE_MOCK_PAYMENT_ENABLED=false

# Set to true to show Payment Integration Test in Profile.
VITE_PAYMENT_TEST_PAGE_ENABLED=false
