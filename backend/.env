# Backend environment variables
# Copy this file to .env and fill in the values

PORT=3001
FRONTEND_URL=http://localhost:5173

# JWT secret — change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Neon PostgreSQL
DATABASE_URL=postgresql://neondb_owner:npg_EKP0bCFMeNX2@ep-weathered-lab-azf8ap65-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?uselibpqcompat=true&sslmode=require&channel_binding=require
DATABASE_SSL=true
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10

# Demo seed identity (used by db:seed)
DEMO_USER_EMAIL=contact@ipasmo.com

# Optional protection for /api/dev/reset-seed (recommended outside local machine)
DEV_RESET_TOKEN=change-me
