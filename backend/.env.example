# Backend environment variables
# Copy this file to .env and fill in the values

PORT=3001
FRONTEND_URL=http://localhost:5173
# Optional comma-separated allow-list for multiple frontend origins
# Example: FRONTEND_URLS=https://app.netlify.app,https://preview--app.netlify.app
FRONTEND_URLS=

# JWT secret — change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Google OAuth Web Client ID (used to verify Google ID tokens)
GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com

# Neon PostgreSQL
DATABASE_URL=postgresql://username:password@ep-xxxxxx.us-east-1.aws.neon.tech/sportygo?uselibpqcompat=true&sslmode=require
DATABASE_SSL=true
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10

# Demo seed identity (used by db:seed)
DEMO_USER_EMAIL=contact@ipasmo.com

# Optional protection for /api/dev/reset-seed (recommended outside local machine)
DEV_RESET_TOKEN=change-me
