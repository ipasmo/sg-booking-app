# Backend environment variables
# Copy this file to .env and fill in the values

PORT=3001
FRONTEND_URL=http://localhost:5173
# Optional comma-separated allow-list for multiple frontend origins
# Example: FRONTEND_URLS=https://app.netlify.app,https://preview--app.netlify.app
FRONTEND_URLS=

# JWT secret — change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret-in-production

# Shared key used to decrypt password payloads coming from frontend.
# Must match frontend VITE_AUTH_PAYLOAD_KEY.
AUTH_PAYLOAD_KEY=change-this-auth-payload-key

# Optional separate key for encrypting password values stored in DB.
# If omitted, AUTH_PAYLOAD_KEY is used.
PASSWORD_AT_REST_KEY=change-this-password-at-rest-key

# Neon PostgreSQL
DATABASE_URL=postgresql://username:password@ep-xxxxxx.us-east-1.aws.neon.tech/sportygo?uselibpqcompat=true&sslmode=require
DATABASE_SSL=true
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10

# Demo seed identity (used by db:seed)
DEMO_USER_EMAIL=contact@ipasmo.com
DEMO_USER_NAME=Demo User
DEMO_USER_MOBILE=+6591234567
DEMO_USER_PASSWORD=Password@123

# Stripe payments (required for card checkout)
# Create a test or live secret key in Stripe Dashboard -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_CURRENCY=sgd


# Optional protection for /api/dev/reset-seed (recommended outside local machine)
DEV_RESET_TOKEN=change-me
